# Copy to backend/.env and adjust. Every setting has a safe development default.

ENVIRONMENT=development

# SQLite for the local demo. For Postgres: postgresql+psycopg://user:pass@localhost:5432/salesway
DATABASE_URL=sqlite:///./salesway.db

# Required outside development. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_MB=10

# --- Assistant ---------------------------------------------------------------
# mock = rule-based understanding + template replies (no key needed)
# anthropic = Claude interprets questions and phrases answers; numbers still come from the
#             analytics engine and are checked before sending. Needs ANTHROPIC_API_KEY.
LLM_PROVIDER=mock
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
ASSISTANT_RATE_LIMIT_PER_MINUTE=30

# --- WhatsApp (Meta Cloud API) -----------------------------------------------
# mock = replies are recorded, not sent (use the simulator on the WhatsApp page)
WHATSAPP_PROVIDER=mock
# Any string you choose; enter the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (App settings > Basic); required to accept webhooks outside development.
WHATSAPP_APP_SECRET=
# System-user token with the whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
